#!/usr/bin/env -S python3 -I
"""Call one SolidCraft MCP tool on a live GUI window.

Usage:
  tools/sc PORT TOOL '{"json": "args"}'      # inline JSON arguments
  tools/sc PORT TOOL @args.json              # arguments from a file
  tools/sc PORT TOOL                         # no arguments
  tools/sc PORT screenshot '{}' --png out.png  # write returned image to a file

Talks to `solidcraft-cli mcp --connect 127.0.0.1:PORT` (the app's own MCP
bridge), so every change shows up in that window. Prints the tool's text
result. Exits non-zero when the tool reports an error.
"""
import base64
import json
import subprocess
import sys
from pathlib import Path

CLI = "/Applications/SolidCraft.app/Contents/MacOS/solidcraft-cli"
ROOT = str(Path(__file__).resolve().parent.parent)


def main() -> int:
    argv = sys.argv[1:]
    png_out = None
    if "--png" in argv:
        i = argv.index("--png")
        png_out = argv[i + 1]
        del argv[i : i + 2]
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    port, tool = argv[0], argv[1]
    raw = argv[2] if len(argv) > 2 else "{}"
    if raw.startswith("@"):
        with open(raw[1:]) as f:
            raw = f.read()
    args = json.loads(raw)

    proc = subprocess.Popen(
        [CLI, "mcp", "--connect", f"127.0.0.1:{port}", "--allow-path", ROOT],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )

    def send(msg):
        proc.stdin.write(json.dumps(msg) + "\n")
        proc.stdin.flush()

    def reply(msg_id):
        for line in proc.stdout:
            line = line.strip()
            if line.startswith("{"):
                msg = json.loads(line)
                if msg.get("id") == msg_id:
                    return msg
        return None

    send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
          "params": {"protocolVersion": "2025-03-26", "capabilities": {},
                     "clientInfo": {"name": "sc", "version": "1"}}})
    reply(1)
    send({"jsonrpc": "2.0", "method": "notifications/initialized"})
    send({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
          "params": {"name": tool, "arguments": args}})
    response = reply(2)
    # Long app work answers "still running"; keep this session and ask `pending`.
    next_id = 3
    while response is not None and "still running" in json.dumps(response.get("result", {})):
        send({"jsonrpc": "2.0", "id": next_id, "method": "tools/call",
              "params": {"name": "pending", "arguments": {}}})
        response = reply(next_id)
        next_id += 1
    proc.stdin.close()
    stderr = proc.stderr.read()
    proc.wait()
    if response is None:
        print(stderr, file=sys.stderr)
        return 1
    if "error" in response:
        print(json.dumps(response["error"], indent=2), file=sys.stderr)
        return 1
    result = response["result"]
    for item in result.get("content", []):
        if item.get("type") == "text":
            print(item["text"])
        elif item.get("type") == "image":
            if png_out is None:
                print(f"[image {item.get('mimeType')} omitted; pass --png FILE]")
            else:
                with open(png_out, "wb") as f:
                    f.write(base64.b64decode(item["data"]))
                print(f"[image written to {png_out}]")
    return 1 if result.get("isError") else 0


if __name__ == "__main__":
    sys.exit(main())
